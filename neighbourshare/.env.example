
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SEED_PASSWORD=
# Secret used to sign session cookies. Generate one with: npx auth secret
# (or: openssl rand -base64 32). Use a different value in each environment.
AUTH_SECRET=
# Only needed when running "npm run build && npm start" on your own machine.
# Vercel sets this automatically.
# AUTH_TRUST_HOST=true
# Listing photo uploads. Copy from the Vercel project (Storage > Blob).
# Leave empty in development to save photos to public/uploads instead.
BLOB_READ_WRITE_TOKEN=
